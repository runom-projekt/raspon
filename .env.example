# Baza danych PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/raspon?schema=public"

# Sesje JWT — wygeneruj losowy sekret (min. 32 znaki), np. `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-secret"
# Dokładnie 32 losowe bajty zakodowane base64, np. `openssl rand -base64 32`.
# Służy wyłącznie do szyfrowania sekretów TOTP w bazie.
TWO_FACTOR_ENCRYPTION_KEY=""

# Adres publiczny aplikacji
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Ustaw true tylko wtedy, gdy aplikacja jest dostępna wyłącznie przez zaufane proxy,
# które nadpisuje X-Real-IP (produkcyjny nginx Raspon spełnia ten warunek).
TRUST_PROXY="false"

# Bramka płatnicza działająca na prawnie wymaganej domenie HMS Runo.
# Sekret (min. 32 losowe znaki) musi być identyczny wyłącznie na obu backendach.
PAYMENT_GATEWAY_URL="https://hms-runo.de/raspon/pay/"
PAYMENT_GATEWAY_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
BANK_TRANSFER_ACCOUNT_HOLDER=""
BANK_TRANSFER_IBAN=""
BANK_TRANSFER_BIC=""

# RUNOM (system agentowy, projekt osobny) — ocena ryzyka anulowania OPŁACONEJ
# rezerwacji (docs/adr/0003-runom-refund-approval.md). Bez tych zmiennych
# anulowanie CONFIRMED+PAID zwraca błąd 503 zamiast automatycznego refundu —
# świadoma decyzja "fail closed", nie cicha degradacja jak przy pozostałych
# integracjach w tym pliku.
# Na produkcji RUNOM działa jako osobna usługa na tym samym hoście, wystawiona
# wyłącznie na 127.0.0.1:3200 (własna sieć Docker, celowo odizolowana od
# kontenerów Raspon) — kontener `app` nie może więc wołać 127.0.0.1:3200
# bezpośrednio. Host nginx (ten sam, co kończy TLS dla raspon.de) proxuje
# publiczną ścieżkę do usługi lokalnie, ten sam wzorzec co PAYMENT_GATEWAY_URL:
# RUNOM_API_URL="https://raspon.de/runom-internal" (bez końcowego "/") —
# wymaga w nginx `location ^~ /runom-internal/ { proxy_pass http://127.0.0.1:3200/; }`,
# zob. docs/OPERATIONS.md, sekcja "Zatwierdzanie refundu przez RUNOM".
RUNOM_API_URL=""
RUNOM_AGENT_ID=""
RUNOM_AGENT_TOKEN=""
RUNOM_OWNER_USER_ID=""
# Kwota (EUR), poniżej połowy której RUNOM auto-akceptuje refund bez udziału
# administratora; od niej wzwyż wymaga ręcznego zatwierdzenia. Domyślnie 200.
RUNOM_REFUND_AUTO_APPROVE_MAX_EUR="200"

# Cloudflare R2 (upload zdjęć) — https://dash.cloudflare.com/ -> R2 -> Manage API Tokens
# Bez tych zmiennych upload zdjęć zwraca błąd 503, reszta aplikacji działa normalnie.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="raspon-media"
# Osobny prywatny bucket bez publicznej domeny. Nie może być tym samym bucketem co R2_BUCKET_NAME.
R2_PRIVATE_BUCKET_NAME="raspon-private-documents"
# Publiczny URL bucketu: albo domyślna domena r2.dev (włącz "Public Access" w ustawieniach
# bucketu), albo własna domena podpięta jako "Custom Domain" — bez końcowego "/"
R2_PUBLIC_URL=""

# Mapy (opcjonalnie — bez klucza używany jest OpenStreetMap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# E-Mail-Verifizierung bei der Registrierung (Resend) — https://resend.com/api-keys
# Ohne diese Variablen wird keine Verifizierungs-E-Mail gesendet und die Verifizierungspflicht
# bleibt deaktiviert (Konten funktionieren wie bisher, ohne Sperre).
# RESEND_FROM_EMAIL erfordert eine in Resend verifizierte Absenderdomain (DNS-Einträge beim Registrar).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Alternatywa dla Resend: uwierzytelniony SMTP (np. skrzynka domenowa Strato).
# Dla portu 465 ustaw SMTP_SECURE=true; dla portu 587 false (STARTTLS).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
# Losowy sekret min. 32 znaki, używany wyłącznie przez lokalny worker systemd.
NOTIFICATION_WORKER_SECRET=""

# SMS (Bird, dawniej MessageBird) — https://app.bird.com/ -> Developers -> API keys
# Bez tych zmiennych powiadomienia SMS są po prostu pomijane (booking/płatność działają normalnie).
SMS_PROVIDER="messagebird"
MESSAGEBIRD_API_KEY=""
# workspaceId i channelId aktywnego kanału SMS — panel Bird -> Channels -> Twój kanał SMS.
MESSAGEBIRD_WORKSPACE_ID=""
MESSAGEBIRD_CHANNEL_ID=""
